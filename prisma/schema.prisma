// Berrima Cement Plant — single-site Inventory Management System (Demo v1)
// SQLite for the demo (zero-infra). Swap provider to "postgresql" + DATABASE_URL for production.
// SQLite has no native enum type, so enum-like fields are plain String columns validated
// in the application layer (see src/lib/domain/enums.ts) against the same value sets.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Locations (single site — Berrima Cement Plant, no site entity/selector)
// ---------------------------------------------------------------------------

model Location {
  id       String  @id @default(cuid())
  name     String  @unique
  type     String // STOCKPILE | YARD | BUNKER | SILO | STORE | WAREHOUSE | PRODUCTION_AREA
  capacity Float?
  // Unit the capacity figure is expressed in, e.g. "MT" | "Nos" — meaningful only alongside
  // capacity. Independent of any material's own uom; no conversion logic anywhere.
  capacityUom String?
  active   Boolean @default(true)

  balances             InventoryBalance[]
  materialsDefaultHere Material[]             @relation("MaterialDefaultLocation")
  txSourceHere         InventoryTransaction[] @relation("TxSourceLocation")
  txDestHere           InventoryTransaction[] @relation("TxDestLocation")
  physicalCounts       PhysicalCount[]
  materialReceipts     MaterialReceipt[]
  requestsFrom         StockRequest[]         @relation("RequestFromLocation")
  requestsTo           StockRequest[]         @relation("RequestToLocation")
  qualityBalances      QualityBalance[]
  qualityStatusEvents  QualityStatusEvent[]
  dispatchesFrom       Dispatch[]             @relation("DispatchSourceLocation")
  spareReturns         SpareReturn[]
}

// ---------------------------------------------------------------------------
// Materials
// ---------------------------------------------------------------------------

model Material {
  id                String   @id @default(cuid())
  materialCode      String   @unique
  name              String
  category          String // RAW_MATERIAL | FUEL | ADDITIVE | INTERMEDIATE | FINISHED_GOODS | PACKING | SPARE
  uom               String // material-specific, e.g. MT | Nos
  minStock          Float? // reorder point — below this, status is CRITICAL
  maxStock          Float? // genuine upper bound — above this, overstock (independent of status)
  defaultLocationId String?
  // Physical Count tolerance band, e.g. 3 = ±3%. Falls back to DEFAULT_TOLERANCE_PCT
  // (reconciliation.ts) when unset — most materials won't need a per-material override.
  tolerancePct      Float?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Spare Management — meaningful only when category = SPARE (a spare IS a Material, not a
  // separate entity). All nullable/free-text; no vendor/procurement/asset-hierarchy module.
  partNumber   String?
  manufacturer String?
  equipmentRef String? // free text, e.g. "Conveyor C-102" — informational only
  criticality  String? // CRITICAL | IMPORTANT | NORMAL

  defaultLocation Location? @relation("MaterialDefaultLocation", fields: [defaultLocationId], references: [id])

  balances         InventoryBalance[]
  transactions     InventoryTransaction[]
  physicalCounts   PhysicalCount[]
  stockRequests    StockRequest[]
  purchaseReferences PurchaseReference[]
  materialReceipts MaterialReceipt[]
  qualityBalances     QualityBalance[]
  qualityStatusEvents QualityStatusEvent[]
  dispatches          Dispatch[]
  spareReturns        SpareReturn[]

  @@index([category])
}

// ---------------------------------------------------------------------------
// Quality Hold / Release — a material physically On Hand (InventoryBalance,
// unchanged) can additionally be split into QC_HOLD / BLOCKED sub-buckets that
// are excluded from what's usable. UNRESTRICTED is never stored: it's always
// derived as OnHand − QC_HOLD − BLOCKED for a given (material, location). This
// mirrors the InventoryTransaction (ledger) / InventoryBalance (materialized
// cache) split for the same reason — O(1) reads without re-summing events.
// ---------------------------------------------------------------------------

model QualityBalance {
  id         String   @id @default(cuid())
  materialId String
  locationId String
  status     String // QC_HOLD | BLOCKED
  quantity   Float    @default(0)
  updatedAt  DateTime @updatedAt

  material Material @relation(fields: [materialId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([materialId, locationId, status])
}

// The audit trail for every quality reclassification (GRN-time hold, manual
// Release/Hold/Block, and automatic reconciliation). userId is a plain string,
// matching InventoryTransaction.userId's existing pattern, not a relation.
model QualityStatusEvent {
  id         String   @id @default(cuid())
  materialId String
  locationId String
  quantity   Float
  fromStatus String // UNRESTRICTED | QC_HOLD | BLOCKED
  toStatus   String // UNRESTRICTED | QC_HOLD | BLOCKED
  userId     String
  reason     String?
  reference  String?
  timestamp  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@index([materialId, locationId])
}

// ---------------------------------------------------------------------------
// Inventory ledger & derived balance
// ---------------------------------------------------------------------------

model InventoryTransaction {
  id                    String   @id @default(cuid())
  timestamp             DateTime
  materialId            String
  transactionType       String // RECEIPT | CONSUMPTION | TRANSFER | TRANSFER_OUT | TRANSFER_IN | ADJUSTMENT | OPENING_BALANCE
  quantity              Float // positive magnitude; direction implied by which location field is set
  uom                   String
  sourceLocationId      String?
  destinationLocationId String?
  reference             String? // supplier/request/GRN reference, free text
  processName           String? // consumption area/process, free text (e.g. "Cement Mill 1")
  reason                String? // mandatory for ADJUSTMENT
  batchLot              String? // set on GRN-sourced receipts where traceability matters
  userId                String?
  createdAt             DateTime @default(now())

  material            Material  @relation(fields: [materialId], references: [id])
  sourceLocation      Location? @relation("TxSourceLocation", fields: [sourceLocationId], references: [id])
  destinationLocation Location? @relation("TxDestLocation", fields: [destinationLocationId], references: [id])

  spareReturn SpareReturn?

  @@index([materialId, timestamp])
  @@index([transactionType])
}

model InventoryBalance {
  id         String   @id @default(cuid())
  materialId String
  locationId String
  quantity   Float    @default(0)
  updatedAt  DateTime @updatedAt

  material Material @relation(fields: [materialId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([materialId, locationId])
}

// ---------------------------------------------------------------------------
// Physical count / adjustment workflow
// ---------------------------------------------------------------------------

model PhysicalCount {
  id                      String   @id @default(cuid())
  locationId              String
  materialId              String
  countedQuantity         Float
  bookQuantityAtCount     Float
  countedBy               String
  countedAt               DateTime
  note                    String?
  adjustmentTransactionId String?
  createdAt               DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@index([locationId, materialId])
}

// ---------------------------------------------------------------------------
// Users & roles (lightweight — no login; current user is a cookie-backed
// selection, but every permission is still checked server-side. See src/lib/auth.ts)
// ---------------------------------------------------------------------------

model User {
  id     String  @id @default(cuid())
  name   String
  role   String // REQUESTER | STORE_SUPERVISOR | STORE_OPERATOR | INVENTORY_MANAGER | ADMIN
  active Boolean @default(true)
  email  String? // optional — only needed for Email-channel notifications; In-App needs none

  notifications Notification[]

  requestsCreated    StockRequest[] @relation("RequestedBy")
  requestsAccepted   StockRequest[] @relation("AcceptedBy")
  requestsRejected   StockRequest[] @relation("RejectedBy")
  requestsRoutedTo   StockRequest[] @relation("RoutedTo")
  requestsRoutedBy   StockRequest[] @relation("RoutedBy")
  requestsAssignedTo StockRequest[] @relation("AssignedTo")
  requestsAssignedBy StockRequest[] @relation("AssignedBy")
  requestsDelivered  StockRequest[] @relation("DeliveredBy")
  events             RequestEvent[]

  dispatchesCreated    Dispatch[]      @relation("DispatchCreatedBy")
  dispatchesAssignedTo Dispatch[]      @relation("DispatchAssignedTo")
  dispatchesApproved   Dispatch[]      @relation("DispatchApprovedBy")
  dispatchesDispatched Dispatch[]      @relation("DispatchDispatchedBy")
  dispatchesCancelled  Dispatch[]      @relation("DispatchCancelledBy")
  dispatchEvents       DispatchEvent[]

  spareReturnsProcessed SpareReturn[]
}

// ---------------------------------------------------------------------------
// Requests — the core workflow. One request moves through several roles;
// the SAME Request ID and record stays attached from creation to completion.
// ---------------------------------------------------------------------------

model StockRequest {
  id                String   @id @default(cuid())
  requestNumber     String   @unique
  materialId        String
  quantityRequested Float
  deliveredQuantity Float    @default(0) // cumulative moved out of source into the in-transit bucket, across delivery rounds
  receivedQuantity  Float    @default(0) // cumulative confirmed received at destination, across rounds
  requiredByDate    DateTime
  priority          String   @default("NORMAL") // NORMAL | URGENT
  status            String   @default("NEW_REQUEST")
  // NEW_REQUEST | ACCEPTED | REJECTED | ASSIGNED | IN_TRANSIT | DELIVERED | NOT_RECEIVED | PARTIALLY_RECEIVED | COMPLETED
  reason            String? // why the material is needed
  note              String?
  fromLocationId    String
  // Nullable — an ISSUE-purpose request has no destination inventory location at all (see
  // `purpose` below); only a TRANSFER-purpose request populates this.
  toLocationId      String?

  // Spare Management — a spare request IS a StockRequest, distinguished only by this
  // discriminator; no new statuses/lifecycle/entity. equipmentRef is free text captured at
  // request time (prefilled from the spare Material's own equipmentRef, but editable) —
  // distinct from Material.equipmentRef, which is just the master-data default.
  requestType  String  @default("MATERIAL") // MATERIAL | SPARE
  equipmentRef String?

  // Request Purpose — TRANSFER (move stock between two locations, the original/default
  // behavior) or ISSUE (stock leaves the source for use/consumption, no destination location).
  // issuedTo is ISSUE's free-text equivalent of toLocationId ("who/what it went to").
  purpose  String  @default("TRANSFER") // TRANSFER | ISSUE
  issuedTo String?

  requestedByUserId String
  requestedByRole   String
  acceptedByUserId  String?
  acceptedAt        DateTime?
  rejectedByUserId  String?
  rejectedAt        DateTime?
  rejectionReason   String?

  // Set by the Inventory Manager to hand an accepted request to one specific Store
  // Supervisor — that supervisor (and only that one) can then assign an operator below.
  // Persists across re-assignment rounds unless the Inventory Manager re-routes it.
  routedToUserId String?
  routedByUserId String?
  routedAt       DateTime?

  assignedToUserId String? // the specific Store/Delivery Operator responsible for this round
  assignedByUserId String?
  assignedAt       DateTime?

  deliveredByUserId String?
  deliveredAt        DateTime?
  deliveryNote        String?

  notReceivedReason String?
  notReceivedAt     DateTime?

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  material     Material  @relation(fields: [materialId], references: [id])
  fromLocation Location  @relation("RequestFromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location? @relation("RequestToLocation", fields: [toLocationId], references: [id])
  requestedBy  User     @relation("RequestedBy", fields: [requestedByUserId], references: [id])
  acceptedBy   User?    @relation("AcceptedBy", fields: [acceptedByUserId], references: [id])
  rejectedBy   User?    @relation("RejectedBy", fields: [rejectedByUserId], references: [id])
  routedTo     User?    @relation("RoutedTo", fields: [routedToUserId], references: [id])
  routedBy     User?    @relation("RoutedBy", fields: [routedByUserId], references: [id])
  assignedTo   User?    @relation("AssignedTo", fields: [assignedToUserId], references: [id])
  assignedBy   User?    @relation("AssignedBy", fields: [assignedByUserId], references: [id])
  deliveredBy  User?    @relation("DeliveredBy", fields: [deliveredByUserId], references: [id])

  reservations StockReservation[]
  events       RequestEvent[]
  spareReturns SpareReturn[]

  @@index([status])
}

// A soft lock on stock at a location for a request that's been assigned but not
// yet physically moved. Reserved stock is still On Hand — it just isn't Available
// for other requests. Released (not deleted) once delivery starts.
model StockReservation {
  id             String    @id @default(cuid())
  stockRequestId String
  materialId     String
  locationId     String
  quantity       Float
  status         String    @default("ACTIVE") // ACTIVE | RELEASED
  createdAt      DateTime  @default(now())
  releasedAt     DateTime?

  stockRequest StockRequest @relation(fields: [stockRequestId], references: [id])

  @@index([materialId, locationId, status])
}

// One row per lifecycle action — the persisted source for the request timeline
// (never hard-coded) and the audit trail (who / role / when / quantity / reason).
model RequestEvent {
  id             String   @id @default(cuid())
  stockRequestId String
  action         String // REQUEST_CREATED | ACCEPTED | REJECTED | ASSIGNED | IN_TRANSIT | DELIVERED | NOT_RECEIVED | RECEIVED | PARTIALLY_RECEIVED | COMPLETED
  userId         String
  role           String
  quantity       Float?
  fromLocationId String?
  toLocationId   String?
  reason         String?
  timestamp      DateTime @default(now())

  stockRequest StockRequest @relation(fields: [stockRequestId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([stockRequestId, timestamp])
}

// ---------------------------------------------------------------------------
// Spare Return — a spare being physically returned to Store against a previously
// issued Spare Request (requestType=SPARE, purpose=ISSUE). Reuses the existing ledger
// (InventoryTransaction via postMovement/RECEIPT) and quality-hold mechanism
// (QualityBalance via changeQualityStatus) unchanged — this table only adds the missing
// persisted record + a real link back to the originating Issue. No separate approval
// workflow, no separate spare ledger: "usable" here means Unrestricted, exactly as
// everywhere else in this app (getTotalUnrestrictedAvailable).
// ---------------------------------------------------------------------------

model SpareReturn {
  id                     String   @id @default(cuid())
  returnReference        String   @unique // RET-YYYYMMDD-XXXX, same convention as REQ-/DIS-/GRN-
  requestId              String // the original Spare Issue — every return must link to one
  originalIssueReference String // denormalized StockRequest.requestNumber, for display without a join
  materialId             String
  quantity               Float
  locationId             String // where the returned stock is added back to
  returnedBy             String // free text — who physically returned it (may not be a system user)
  processedByUserId      String // the Store Operator (or Inventory Manager/Admin) who processed it
  condition               String // RETURN_CONDITIONS — UNUSED | SERVICEABLE | DAMAGED | FOR_INSPECTION
  reason                  String?
  remarks                 String?
  inventoryTransactionId  String   @unique // the RECEIPT InventoryTransaction this return posted
  createdAt               DateTime @default(now())

  request              StockRequest         @relation(fields: [requestId], references: [id])
  material             Material             @relation(fields: [materialId], references: [id])
  location             Location             @relation(fields: [locationId], references: [id])
  processedBy          User                 @relation(fields: [processedByUserId], references: [id])
  inventoryTransaction InventoryTransaction @relation(fields: [inventoryTransactionId], references: [id])

  @@index([requestId])
  @@index([materialId])
}

// ---------------------------------------------------------------------------
// Receive Material — supplier, PO/source reference & GRN document tracking.
// Deliberately minimal — not a full procurement/supplier module. Separate
// from the internal Request lifecycle above.
// ---------------------------------------------------------------------------

model Supplier {
  id            String   @id @default(cuid())
  name          String
  referenceCode String?
  contactInfo   String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  purchaseReferences PurchaseReference[]
  materialReceipts   MaterialReceipt[]
}

// A tracking-only PO/source reference. Status is derived from the cumulative
// ACCEPTED quantity of its POSTED receipts.
model PurchaseReference {
  id                   String    @id @default(cuid())
  poNumber             String    @unique
  supplierId           String
  materialId           String
  orderedQuantity      Float
  expectedDeliveryDate DateTime?
  note                 String?
  status               String    @default("EXPECTED") // EXPECTED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  supplier Supplier          @relation(fields: [supplierId], references: [id])
  material Material          @relation(fields: [materialId], references: [id])
  receipts MaterialReceipt[]

  @@index([status])
}

// Material Receipt / GRN. Only a POSTED receipt affects inventory — and only by its
// acceptedQuantity, never orderedQuantity or receivedQuantity. Cancelling a POSTED
// receipt never deletes history; it posts a reversal and keeps both transactions.
model MaterialReceipt {
  id                      String    @id @default(cuid())
  grnNumber               String    @unique
  receiptDate             DateTime
  supplierId              String
  purchaseReferenceId     String?
  materialId              String
  orderedQuantitySnapshot Float? // copied from the PO at receipt time, for display even if the PO later changes
  receivedQuantity        Float
  acceptedQuantity        Float
  rejectedQuantity        Float
  // Quality status the accepted quantity posts as — UNRESTRICTED unless the receiver
  // flags it QC_HOLD/BLOCKED at GRN time (see src/lib/inventory/quality.ts).
  qualityStatus           String    @default("UNRESTRICTED")
  destinationLocationId   String
  batchLot                String?
  invoiceNumber           String?
  invoiceDate             DateTime?
  invoiceAmount           Float?
  deliveryNoteNumber      String?
  supplierChallan         String?
  vehicleReference        String?
  truckNumber             String?
  notes                   String?
  status                  String    @default("DRAFT") // DRAFT | POSTED | CANCELLED
  postedAt                DateTime?
  inventoryTransactionId  String? // the RECEIPT ledger row this GRN posted (accepted quantity)
  reversalTransactionId   String? // set if a POSTED receipt was later cancelled
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  supplier            Supplier           @relation(fields: [supplierId], references: [id])
  purchaseReference   PurchaseReference? @relation(fields: [purchaseReferenceId], references: [id])
  material            Material           @relation(fields: [materialId], references: [id])
  destinationLocation Location           @relation(fields: [destinationLocationId], references: [id])

  @@index([status])
  @@index([materialId])
}

// ---------------------------------------------------------------------------
// Dispatch — finished-goods/customer dispatch. Separate from the internal
// Stock Request lifecycle above: this is material leaving the plant for a
// customer, not moving between two internal locations. Only Unrestricted
// stock is eligible (checked live against QualityBalance at Approve, Start
// Loading, and immediately before the DISPATCHED ledger write — see
// src/lib/inventory/dispatch.ts). Mirrors the StockRequest/RequestEvent split:
// denormalized actor columns here for fast display, DispatchEvent below is the
// append-only audit trail / timeline source.
// ---------------------------------------------------------------------------

model Dispatch {
  id                  String   @id @default(cuid())
  dispatchReference   String   @unique
  materialId          String
  quantity            Float
  sourceLocationId    String
  customerDestination String
  status              String   @default("CREATED")
  // CREATED | APPROVED | LOADING | DISPATCHED | CANCELLED
  batchLot            String?
  weighmentReference  String?
  notes               String?

  createdByUserId String
  createdAt       DateTime @default(now())

  // The specific Store Operator who will execute this dispatch — set (and
  // re-settable while still APPROVED) at Approval time, since the spec's own
  // RBAC requires Store Operator to see/act on only their assigned Dispatches.
  assignedToUserId String?
  approvedByUserId String?
  approvedAt       DateTime?

  loadingStartedByUserId String?
  loadingStartedAt       DateTime?

  dispatchedByUserId     String?
  dispatchedAt            DateTime?
  inventoryTransactionId String? // the DISPATCH ledger row — set only once actually dispatched

  cancelledByUserId  String?
  cancelledAt         DateTime?
  cancellationReason String?

  updatedAt DateTime @updatedAt

  material       Material @relation(fields: [materialId], references: [id])
  sourceLocation Location @relation("DispatchSourceLocation", fields: [sourceLocationId], references: [id])
  createdBy      User     @relation("DispatchCreatedBy", fields: [createdByUserId], references: [id])
  assignedTo     User?    @relation("DispatchAssignedTo", fields: [assignedToUserId], references: [id])
  approvedBy     User?    @relation("DispatchApprovedBy", fields: [approvedByUserId], references: [id])
  dispatchedBy   User?    @relation("DispatchDispatchedBy", fields: [dispatchedByUserId], references: [id])
  cancelledBy    User?    @relation("DispatchCancelledBy", fields: [cancelledByUserId], references: [id])

  events DispatchEvent[]

  @@index([status])
}

// One row per lifecycle action — the persisted source for the Dispatch timeline
// and audit trail (who / role / when / reason), same pattern as RequestEvent.
model DispatchEvent {
  id         String   @id @default(cuid())
  dispatchId String
  action     String // CREATED | APPROVED | REASSIGNED | LOADING_STARTED | DISPATCHED | CANCELLED
  userId     String
  role       String
  reason     String?
  timestamp  DateTime @default(now())

  dispatch Dispatch @relation(fields: [dispatchId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([dispatchId, timestamp])
}

// ---------------------------------------------------------------------------
// Notifications — additive, sits on top of the existing workflows above.
// Never a source of truth for inventory/request/dispatch state; only ever
// references those existing records by id.
// ---------------------------------------------------------------------------

model NotificationRule {
  id               String   @id @default(cuid())
  event            String   // one of NOTIFICATION_EVENTS (src/lib/notifications/events.ts)
  recipientType    String   // ROLE | SPECIFIC_USER | RELEVANT_USER
  recipientRole    String?  // set when recipientType = ROLE
  recipientUserId  String?  // set when recipientType = SPECIFIC_USER
  channel          String   // IN_APP | EMAIL | BOTH
  status           String   @default("ENABLED") // ENABLED | DISABLED
  notificationType String   // ACTION_REQUIRED | INFORMATION
  title            String   // may contain {template} variables
  message          String   // may contain {template} variables
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  notifications Notification[]

  @@index([event, status])
}

model Notification {
  id                String    @id @default(cuid())
  ruleId            String?
  recipientUserId   String
  type              String    // ACTION_REQUIRED | INFORMATION
  title             String
  message           String
  relatedRecordType String?   // REQUEST | DISPATCH | MATERIAL
  relatedRecordId   String?
  link              String?   // concrete existing route, e.g. /requests/<id>
  read              Boolean   @default(false)
  readAt            DateTime?
  channel           String    // IN_APP | EMAIL | BOTH, copied from the rule at generation time
  emailStatus       String?   // SENT | FAILED | NOT_APPLICABLE
  emailError        String?
  createdAt         DateTime  @default(now())

  rule      NotificationRule? @relation(fields: [ruleId], references: [id])
  recipient User              @relation(fields: [recipientUserId], references: [id])

  @@index([recipientUserId, read])
}

// Last-known stock status per material, used only to detect a WORSENING transition
// (HEALTHY->LOW->CRITICAL) so Stock Low/Critical notifications fire once per transition,
// not once per balance-changing action while already critical. Never read by any existing
// inventory calculation — purely a notification-system cache.
model MaterialAlertState {
  materialId String   @id
  lastStatus String   // HEALTHY | LOW | CRITICAL
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Report Scheduling — a persisted delivery preference for an existing /reports tab, not a
// real cron job (this sandboxed app has no background job runner). "Run Now" is the only way
// a schedule is ever actually executed; frequency is a stored label describing intended
// cadence only.
// ---------------------------------------------------------------------------

model ReportSchedule {
  id              String   @id @default(cuid())
  reportType      String   // inventory | consumption | movement | request | dispatch — matches /reports?tab= values
  frequency       String   // DAILY | WEEKLY | MONTHLY — a label only, nothing fires automatically
  timeOfDay       String   @default("09:00") // "HH:mm", 24-hour, wall-clock only — no timezone/DateTime, matches the "label only" framing
  dayOfWeek       String?  // MONDAY..SUNDAY — set when frequency = WEEKLY
  dayOfMonth      Int?     // 1-31 — set when frequency = MONTHLY
  recipientType   String   // ROLE | SPECIFIC_USER
  recipientRole   String?  // set when recipientType = ROLE
  recipientUserId String?  // set when recipientType = SPECIFIC_USER
  status          String   @default("ENABLED") // ENABLED | DISABLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  runs ReportScheduleRun[]

  @@index([status])
}

// One row per "Run Now" click — a batch summary, not one row per recipient (unlike
// Notification, there's no in-app inbox equivalent here). scheduleId is nullable with
// onDelete: SetNull so deleting a schedule doesn't destroy its run history.
model ReportScheduleRun {
  id             String   @id @default(cuid())
  scheduleId     String?
  runAt          DateTime @default(now())
  recipientCount Int
  emailStatus    String   // SENT | FAILED — mirrors Notification.emailStatus

  schedule ReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([scheduleId])
}
